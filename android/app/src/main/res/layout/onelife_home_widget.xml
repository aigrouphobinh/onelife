<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="14dp"
    android:orientation="vertical"
    android:background="@drawable/onelife_widget_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/widget_brain"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_onelife_today"
            android:contentDescription="@string/onelife_widget_mascot"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OneLife"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold"
                android:textSize="18sp"/>
            <TextView
                android:id="@+id/widget_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="@string/onelife_widget_empty"
                android:textColor="#FFF7ECFF"
                android:textSize="13sp"/>
        </LinearLayout>
        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="36dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:contentDescription="@string/onelife_widget_refresh"
            android:text="↻"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp"/>
    </LinearLayout>
    <TextView
        android:id="@+id/widget_focus_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingTop="5dp"
        android:paddingBottom="9dp"
        android:text="@string/onelife_widget_focus"
        android:textColor="#FFEBD9FF"
        android:textSize="12sp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/widget_tasks"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:background="@drawable/onelife_widget_button"
            android:contentDescription="@string/onelife_widget_tasks"
            android:text="@string/onelife_widget_tasks"
            android:textColor="#FF39235B"
            android:textSize="12sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/widget_capture"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="4dp"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:background="@drawable/onelife_widget_button"
            android:contentDescription="@string/onelife_widget_capture"
            android:text="@string/onelife_widget_capture"
            android:textColor="#FF39235B"
            android:textSize="12sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/widget_focus"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:background="@drawable/onelife_widget_button"
            android:contentDescription="@string/onelife_widget_focus_button"
            android:text="@string/onelife_widget_focus_button"
            android:textColor="#FF39235B"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>